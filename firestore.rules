rules_version = '2';

// ============================================================
//  Tavasya Capital — Compliance, Investments and Investor Relations:
//  security rules
//
//  Paste the whole of this file into
//  Firebase Console → Firestore Database → Rules → Publish,
//  on the tavasya-investments project, which all three sections use.
//  (Not the old tavasya-compliance-a2295 project the standalone
//  Compliance Register ran on.)
//
//  These rules are the ONLY thing protecting your data. The app's
//  screens just hide buttons; the rules actually enforce who can do
//  what, including for anyone poking at the database directly.
//
//  Roles (one team list for all three sections):
//    admin    — everything, plus managing the team list, adding and
//               archiving schemes, and deleting an investment, an
//               investor or a compliance row.
//    teamlead — everything a member can, plus deleting a task and a
//               compliance type.
//    member   — see everything; add and edit records and tasks.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // EDIT THIS ONE LINE if the domain ever changes. Escape dots as [.] — it's a regex.
    function emailPattern() {
      return '^[^@]+@tavasyacapital[.]in$';
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    // Signed in, inbox confirmed, and on our domain.
    function onDomain() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && callerEmail().matches(emailPattern());
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(callerEmail())).data;
    }

    // On the domain AND on the team list AND not switched off. All three
    // matter: a valid @tavasyacapital.in account that nobody has added to
    // the team list still gets nowhere.
    function isMember() {
      return onDomain()
        && exists(/databases/$(database)/documents/users/$(callerEmail()))
        && profile().active == true;
    }

    function isAdmin() {
      return isMember() && profile().role == 'admin';
    }
    function isTeamLead() {
      return isMember() && profile().role == 'teamlead';
    }

    // ---------- the team list ----------
    // Everyone can read their own entry, which is what the sign-in check
    // itself needs. Any active member can read the whole roster, needed to
    // put names against owners. Only an admin can change it.
    // Document ID is the person's lowercase email.
    match /users/{email} {
      allow get:  if isMember() || (onDomain() && callerEmail() == email);
      allow list: if isMember();
      allow write: if isAdmin();
    }

    // ---------- schemes ----------
    // Everyone active can see the list — it drives the button bar and the
    // investment form's dropdown. Only an admin can add or archive one.
    // Document ID is the scheme's short code (e.g. "SSF").
    match /schemes/{schemeId} {
      allow get, list: if isMember();
      allow create, update: if isAdmin();
      allow delete: if false; // archive (active:false) instead — existing
                              // investments still reference the code
    }

    // ---------- dropdown values ----------
    // One document per dropdown (instrument, stage, cirpStage, sector,
    // tranche, category, priority, leadDays for Investments; investorType,
    // investorStatus, industry, investorCategory for Investor Relations),
    // each holding a `values` array of whatever has
    // been added from inside the app via "+ Add new…".
    //
    // Deliberately open to any active member, like compliance types in the
    // other app: these are labels, not structural entities, and needing an
    // admin to add "Slump Sale" mid-form would just push people to type it
    // into the notes instead. Nothing here can expose data — a stray value
    // is cosmetic, and an admin can tidy the list.
    match /optionLists/{listId} {
      allow get, list: if isMember();
      allow create, update: if isMember();
      allow delete: if isAdmin();
    }

    // ---------- investments ----------
    // One document per position held by a Scheme, and one per CIRP case
    // (track == 'cirp') being pursued for one. Auto-generated IDs: two
    // investments in the same scheme can legitimately share a name (separate
    // tranches, for instance), so there's no natural composite key here.
    //
    // Deletion is admin-only, as a guard rail against losing a record along
    // with all its tasks. Everyone else archives instead (archived: true),
    // which keeps the history and just hides it from the default list.
    match /investments/{investmentId} {
      allow get, list: if isMember();

      allow create: if isMember()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.schemeCode is string
        && request.resource.data.schemeCode.size() > 0;

      allow update: if isMember();
      allow delete: if isAdmin();
    }

    // ---------- investment tasks ----------
    // Children of an investment, linked by investmentId. Two kinds:
    //   taskType == 'timed' — has a dueDate, and the daily script emails
    //                         its owner from reminderLeadDays out.
    //   taskType == 'open'  — tracked but never emails anyone.
    //
    // Deleting is allowed for Admin and Team Lead, a notch looser than
    // investments: a stray task is ordinary housekeeping, not data loss.
    match /investmentTasks/{taskId} {
      allow get, list: if isMember();

      allow create: if isMember()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.investmentId is string
        && request.resource.data.investmentId.size() > 0
        && request.resource.data.completed is bool
        && request.resource.data.taskType in ['timed', 'open'];

      allow update: if isMember();
      allow delete: if isAdmin() || isTeamLead();
    }

    // ---------- reminder log ----------
    // Written only by the scheduled script, which authenticates with a
    // service account and bypasses these rules entirely. Members can read
    // it to see what was last sent; nobody writes it from the browser.
    match /investmentReminderLog/{taskId} {
      allow get, list: if isMember();
      allow write: if false;
    }

    // ================= INVESTOR RELATIONS =================
    // Same shape as investments and their tasks.

    // ---------- investors ----------
    // One document per investor in a Scheme. Deleting is admin-only, as a
    // guard rail; everyone else archives instead.
    match /investors/{investorId} {
      allow get, list: if isMember();

      allow create: if isMember()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.schemeCode is string
        && request.resource.data.schemeCode.size() > 0;

      allow update: if isMember();
      allow delete: if isAdmin();
    }

    // ---------- investor tasks ----------
    // Children of an investor, linked by investorId. Same two kinds as
    // investment tasks ('timed' emails reminders, 'open' never does).
    match /investorTasks/{taskId} {
      allow get, list: if isMember();

      allow create: if isMember()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.investorId is string
        && request.resource.data.investorId.size() > 0
        && request.resource.data.completed is bool
        && request.resource.data.taskType in ['timed', 'open'];

      allow update: if isMember();
      allow delete: if isAdmin() || isTeamLead();
    }

    match /investorReminderLog/{taskId} {
      allow get, list: if isMember();
      allow write: if false;
    }

    // ================= COMPLIANCE =================
    // Carried over unchanged from the standalone Compliance Register's
    // rules.

    // ---------- compliance types ----------
    // Any active member can ADD one inline while filling out the compliance
    // form. Deleting is heavier — it can silently change data other people
    // created — so that's restricted to Admin and Team Lead.
    match /complianceTypes/{typeId} {
      allow get, list: if isMember();
      allow create: if isMember();
      allow delete: if isAdmin() || isTeamLead();
      allow update: if false;
    }

    // ---------- compliances ----------
    // Document ID is deterministic: `${schemeCode}-${obligationCode}-${dueDate|ONG}`,
    // a stable, human-readable key so re-importing the same data twice
    // overwrites in place instead of creating copies.
    match /compliances/{complianceId} {
      allow get, list: if isMember();

      allow create: if isMember()
        && request.resource.data.obligation is string
        && request.resource.data.obligation.size() > 0
        && request.resource.data.scheme is string
        && request.resource.data.dueDate is string
        && request.resource.data.completed is bool;

      // Any member can update (mark complete, edit dates/links/notes).
      allow update: if isMember();

      // Only an admin can delete a row.
      allow delete: if isAdmin();
    }

    // ---------- compliance reminder log ----------
    // One doc per compliance, written by the scheduled script. Members can
    // read it; nobody writes it from the browser.
    match /reminderLog/{complianceId} {
      allow get, list: if isMember();
      allow write: if false;
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
